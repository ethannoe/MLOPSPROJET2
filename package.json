{
  "name": "tp-cicd-app",
  "version": "1.0.0",
  "description": "Application Todo (API + page web) déployée automatiquement sur une VM Azure via GitHub Actions",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "start-server-and-test start http://localhost:3000/health cy:run",
    "cy:run": "cypress run",
    "cy:open": "cypress open"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "cypress": "^16.2.0",
    "jest": "^30.5.2",
    "start-server-and-test": "^3.0.13",
    "supertest": "^7.3.1"
  }
}
